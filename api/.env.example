# API environment variables. Copy to .env and fill in real values; never commit .env.
# Placeholders only. Railway holds the production values.

# --- Database ---
# Production connection string (Supabase Postgres, connecting as the API's database role).
DATABASE_URL=postgres://api_role:password@db.example.supabase.co:5432/postgres
# Local and CI Postgres for development and tests. Defaults match docker-compose.yml.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres

# --- Supabase ---
# Project URL, used for Storage calls.
SUPABASE_URL=https://example.supabase.co
# JWKS endpoint used to verify sign-in JWTs.
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
# Service role key for server-side Storage access, creating the demo users and deleting Auth users.
# Server only.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Private bucket holding ID images until they are confirmed or purged.
STORAGE_BUCKET=id-documents

# --- LLM ---
# Provider for chat: anthropic, groq, gemini or ollama.
LLM_PROVIDER=groq
# Model name for the chosen provider. Leave empty for the provider's default.
LLM_MODEL=
# Provider tried once on a timeout, 5xx, 429 or connection failure. Leave empty for none.
LLM_FALLBACK_PROVIDER=
# Model name for the fallback provider. Leave empty for that provider's default.
LLM_FALLBACK_MODEL=
# Provider keys. Only the ones for configured providers are needed; Groq or Ollama alone is enough.
CLAUDE_API_KEY=replace-me
GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
# Base URL of a local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# --- Encryption and audit ---
# Active Record encryption keys for personal-data columns. Generate with bin/rails db:encryption:init.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-me
# HMAC key for pseudonymous actor references in the audit log.
AUDIT_HMAC_KEY=replace-me
# Decrypts config/credentials.yml.enc in production. Not needed when SECRET_KEY_BASE is set.
RAILS_MASTER_KEY=replace-me
# Signs Rails' own tokens in production. Generate with bin/rails secret.
SECRET_KEY_BASE=replace-me

# --- HTTP and uploads ---
# Web app origin(s) allowed by CORS, comma-separated. Required in production (the API won't boot
# without it); development and test default to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000
# Upload size limit in megabytes.
MAX_UPLOAD_MB=10
# Minimum OCR confidence (0-100) for a field to be pre-filled instead of left blank.
OCR_CONFIDENCE_THRESHOLD=60

# --- Eval (optional) ---
# Golden set directory (images plus labels.json) for the seed and the eval tasks, relative to api/.
GOLDEN_DIR=eval/golden
# Where rake ai:eval writes its results files, relative to api/.
RESULTS_DIR=eval/results

# --- Performance tooling (optional; docs/performance.md) ---
# The API that rake perf:ocr and perf:booking time.
PERF_BASE_URL=http://localhost:3001
# Password for the load-test users rake perf:users creates. Any strong value; never commit it.
PERF_USER_PASSWORD=
# How many load-test users rake perf:users creates (one per k6 virtual user).
PERF_USERS=20
# Where rake perf:users writes the users' access tokens, relative to api/. Keep it untracked.
PERF_TOKENS_FILE=tmp/perf-tokens.json
# Runs per timing task.
PERF_RUNS=20
# The API's log, for server-side times from its Lograge lines. Empty for client-side times only.
PERF_LOG_FILE=
# Supabase anon key for signing in the load-test users. Empty to use the service role key.
SUPABASE_ANON_KEY=

# --- Rails runtime (optional; defaults shown) ---
# Port Puma listens on. 3001 locally, beside the web app on 3000; Railway sets its own.
PORT=3001
# Puma threads per process, and the database pool size.
RAILS_MAX_THREADS=3
# Run Solid Queue inside Puma. Set in production so jobs need no separate worker.
SOLID_QUEUE_IN_PUMA=true
# Solid Queue worker processes.
JOB_CONCURRENCY=1
# Production log level.
RAILS_LOG_LEVEL=info
# Puma pidfile path. Leave empty for none.
PIDFILE=
