# Web environment variables. Copy to .env.local and fill in real values; never commit it.
# Placeholders only. NEXT_PUBLIC_ values are sent to the browser, so they must never be secrets.

# Supabase project URL, used only for sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
# Supabase anon key. Public by design; row-level security denies it all table access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Base URL of the Rails API.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Seconds of inactivity before the long-pause supportive content appears.
NEXT_PUBLIC_LONG_PAUSE_SECONDS=45
# Largest ID photo, in MB, the browser will send. Match the API's MAX_UPLOAD_MB; the API enforces it.
NEXT_PUBLIC_MAX_UPLOAD_MB=10
